# Higgsfield credentials. Never commit a populated .env file.
HF_API_KEY=
HF_SECRET=

# Provider selection. Only higgsfield-v1 is implemented in v1.0.
HF_PROVIDER=higgsfield-v1

# Optional overrides (defaults shown).
# HF_API_BASE_URL=https://api.higgsfield.ai
# HF_REQUEST_TIMEOUT_MS=120000
# HF_RETRY_COUNT=3
# HF_RETRY_BACKOFF_MS=1000
# HF_RETRY_MAX_BACKOFF_MS=30000
# HF_POLL_INTERVAL_MS=2000
# HF_IMAGE_POLL_LIMIT_MS=300000
# HF_VIDEO_POLL_LIMIT_MS=900000
# HF_CACHE_ROOT=.cache/higgsfield
# HF_DEBUG=0
